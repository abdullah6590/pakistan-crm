# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
*.db

# database backups and legacy SQL Server files (contain business and personal data; audit SEC-07)
*.bak
*.bacpac
*.mdf
*.ldf
/backups/

# restore drills and recovered copies (decrypted data; never commit)
restore-drill/
recovery/

# desktop app build output
/.next-desktop/

# audit reports and evidence: analysis of the legacy business database (U2024) and owner details.
# The repository is public, so they stay on the owner's computer only (owner decision 2026-10-23).
/audit-reports/

# Agent reports, design notes and tool state: they describe security details, and the repository is public,
# so they stay on the owner's computer only (owner decision 2026-10-30)
/codex-analysis/
/docs/superpowers/
/.superpowers/

# desktop test results (generated by the test scripts)
/desktop/*-results.json
