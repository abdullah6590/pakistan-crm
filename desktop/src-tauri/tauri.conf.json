{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pakistan CRM",
  "version": "0.1.5",
  "identifier": "pk.pakistancrm.desktop",
  "build": {
    "frontendDist": "../loading",
    "beforeBundleCommand": "node check-bundle.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../bundle/app/": "app/",
      "../bundle/node/": "node/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
