// prisma/schema.prisma
// Electronics Startup ERP - Database Schema
// Supports: PostgreSQL (production) & SQLite (development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── ENUMS ────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PARTNER
  EMPLOYEE
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum IncomeCategory {
  PROJECT_PAYMENT
  COMPONENT_SALE
  INVESTMENT
  OTHER_INCOME
}

enum ExpenseCategory {
  COMPONENT_PURCHASE
  SALARY
  UTILITY
  RENT
  TRAVEL
  HARDWARE
  SOFTWARE
  MARKETING
  SHIPPING
  TAX
  OTHER_EXPENSE
  RENT_SHOP
  RENT_GODOWN
  DAILY_MISC
}

enum NotificationType {
  LOW_STOCK
  PENDING_PAYMENT
  PROJECT_DEADLINE
  SUPPLIER_DUE
  OVERDUE_INVOICE
  SYSTEM
}

enum PaymentMethodType {
  CASH
  CHEQUE
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  NAYAPAY
  SADAPAY
}

enum AccountType {
  BANK
  CASH
  EXPENSE
  DIGITAL_WALLET
}

enum TransferType {
  CASH_TO_BANK
  BANK_TO_CASH
  CASH_TO_WALLET
  WALLET_TO_BANK
  INTERNAL
}

// ─── USER & AUTH ───────────────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  password       String
  role           UserRole      @default(EMPLOYEE)
  image          String?
  phone          String?
  address        String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  projects       Project[]
  teamMemberships TeamMember[]
  sales          Sale[]
  purchases      Purchase[]
  financeRecords Finance[]
  notifications  Notification[]
  accounts       Account[]
  sessions       Session[]

  @@map("users")
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime? // set by the app (an older session row has none)
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  revokeReason String?
  userAgent    String?
  ipHash       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expires])
  @@map("sessions")
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ─── PROJECT MANAGEMENT ───────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  projectId       String        @unique // Human-readable: PRJ-001
  name            String
  description     String?
  clientName      String?
  clientPhone     String?
  clientEmail     String?
  startDate       DateTime      @default(now())
  deadline        DateTime?
  status          ProjectStatus @default(PLANNING)
  laborCost       Float         @default(0)
  otherCosts      Float         @default(0)
  clientPayment   Float         @default(0)
  paymentStatus   PaymentStatus @default(PENDING)
  remainingPayment Float        @default(0)
  totalCost       Float         @default(0)
  profit          Float         @default(0)
  notes           String?
  color           String        @default("#3B82F6")

  userId          String        // Project Manager
  user            User          @relation(fields: [userId], references: [id])
  teamMembers     TeamMember[]
  components      ProjectComponent[]
  attachments     Attachment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("projects")
}

model TeamMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   // e.g., "Developer", "Designer", "Technician"
  hours     Float    @default(0)
  rate      Float    @default(0)
  cost      Float    @default(0) // hours * rate

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@map("team_members")
}

model ProjectComponent {
  id           String   @id @default(cuid())
  projectId    String
  componentId  String
  quantity     Int      @default(1)
  unitCost     Float    @default(0) // Snapshot of cost at time of use
  totalCost    Float    @default(0) // quantity * unitCost

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  component    Component @relation(fields: [componentId], references: [id])

  createdAt    DateTime @default(now())

  @@unique([projectId, componentId])
  @@map("project_components")
}

// ─── INVENTORY MANAGEMENT ─────────────────────────────────────────

model ComponentCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  icon        String?
  color       String      @default("#6366F1")

  components  Component[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("component_categories")
}

model Component {
  id              String             @id @default(cuid())
  sku             String             @unique // Stock Keeping Unit
  name            String
  description     String?
  categoryId      String
  category        ComponentCategory  @relation(fields: [categoryId], references: [id])
  quantity        Int                @default(0)
  minQuantity     Int                @default(5) // Low stock threshold
  
  // Bulk Tracking
  packagingUnit   String             @default("Carton") // e.g. Carton, Bottle, Ream, Pack
  itemsPerPackage Int                @default(1) // Number of items inside one package

  // Pricing
  supplierPrice   Float              @default(0) // Base price from supplier
  expenses        Float              @default(0) // Freight, tax, labor, etc
  unitCost        Float              @default(0) // Purchase Rate (Calculated or Final)
  unitPrice       Float              @default(0) // Sale Rate
  supplierId      String?
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])
  location        String?            // Shelf/Bin location
  datasheetUrl    String?
  imageUrl        String?
  isActive        Boolean            @default(true)

  // Stock details
  size            String?            // e.g., "14 inch", "A4", "Large"
  grams           Float?             // Weight in grams
  unit            String             @default("piece") // "piece", "sheet", "meter", "kg"
  customFields    String?            // JSON string for flexible key-value data

  // Paper Product Dimensions & Pricing Formula
  dimensionX     Float?             // Length (inches)
  dimensionY     Float?             // Width (inches)
  gsm            Float?             // Grams per square meter
  divisor        Float?             @default(15500) // Weight divisor (varies by category/size)
  weightKg       Float?             // Calculated: (X × Y × GSM) / Divisor
  rimInSheet     Int?               @default(100) // Sheets per ream (adjustable)
  ratePerKg      Float?             // Rate per KG for auto-pricing

  // Tracking
  totalPurchased  Int                @default(0)
  totalUsed       Int                @default(0) // Used in projects
  totalSold       Int                @default(0) // Sold to customers
  totalDamaged    Int                @default(0)
  lastPurchasedAt DateTime?
  lastSoldAt      DateTime?

  // Relations
  projectComponents ProjectComponent[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  inventoryHistory  InventoryHistory[]
  unitProfile       ItemUnitProfile?
  documentLines     AccountingDocumentLine[]
  stockMovements    StockMovement[]
  stockBalances     ItemStockBalance[]
  costState         ItemCostState?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([categoryId])
  @@index([supplierId])
  @@index([sku])
  @@map("components")
}

model InventoryHistory {
  id           String       @id @default(cuid())
  componentId  String
  component    Component    @relation(fields: [componentId], references: [id])
  type         String       // "PURCHASE", "PROJECT_USE", "SALE", "DAMAGED", "ADJUSTMENT", "RETURN"
  quantity     Int          // Positive for additions, negative for deductions
  balanceAfter Int
  reference    String?      // Project ID, Sale ID, Purchase ID
  notes        String?
  performedBy  String?

  createdAt    DateTime     @default(now())

  @@map("inventory_history")
}

// ─── SUPPLIERS ─────────────────────────────────────────────────────

model Supplier {
  id              String       @id @default(cuid())
  name            String
  company         String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String       @default("Pakistan")
  taxNumber       String?
  notes           String?
  contactPerson   String?
  customFields    String?      // JSON list of {label, value}: the owner's own supplier details
  totalPurchased  Float        @default(0)
  balanceDue      Float        @default(0)
  isActive        Boolean      @default(true)

  components      Component[]
  purchases       Purchase[]
  supplierPayments SupplierPayment[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("suppliers")
}

// ─── CUSTOMERS ─────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  totalPurchased Float    @default(0)
  balanceDue     Float    @default(0)
  visitCount     Int      @default(0)
  notes          String?
  isActive       Boolean  @default(true)

  sales          Sale[]
  customerPayments CustomerPayment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("customers")
}

// ─── SALES MODULE ──────────────────────────────────────────────────

model Sale {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // INV-001
  customerId      String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  walkInName     String?       // For walk-in customers without account
  subtotal        Float         @default(0)
  discount        Float         @default(0)
  tax             Float         @default(0)
  total           Float         @default(0)
  profit          Float         @default(0)
  paymentMethod   String        @default("CASH") // CASH, BANK_TRANSFER, JAZZCASH, EASYPAISA
  paymentStatus   PaymentStatus @default(PAID)
  notes           String?
  userId          String        // Who processed the sale
  user            User          @relation(fields: [userId], references: [id])

  items           SaleItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id          String    @id @default(cuid())
  saleId      String
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id])
  quantity    Int       @default(1)
  unitCost    Float     @default(0) // Cost price snapshot
  unitPrice   Float     @default(0) // Selling price
  totalCost   Float     @default(0)
  totalPrice  Float     @default(0)
  profit      Float     @default(0) // (unitPrice - unitCost) * quantity

  createdAt   DateTime  @default(now())

  @@index([saleId])
  @@index([componentId])
  @@map("sale_items")
}

// ─── PURCHASE MODULE ───────────────────────────────────────────────

model Purchase {
  id            String        @id @default(cuid())
  poNumber      String        @unique // PO-001
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  invoiceRef    String?
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  shipping      Float         @default(0)
  total         Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  paidAmount    Float         @default(0)
  notes         String?
  userId        String        // Who created the purchase
  user          User          @relation(fields: [userId], references: [id])

  items         PurchaseItem[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([supplierId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([poNumber])
  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id])
  quantity    Int       @default(1)
  unitCost    Float     @default(0)
  totalCost   Float     @default(0)

  createdAt   DateTime  @default(now())

  @@index([purchaseId])
  @@index([componentId])
  @@map("purchase_items")
}

// ─── FINANCE MODULE ────────────────────────────────────────────────

model Finance {
  id              String          @id @default(cuid())
  transactionRef  String          @unique // TXN-001
  type            TransactionType
  category        String          // Maps to IncomeCategory or ExpenseCategory
  amount          Float
  description     String
  paymentMethod   String          @default("CASH")
  reference       String?         // Link to Sale, Purchase, Project, etc.
  referenceId     String?
  date            DateTime        @default(now())
  userId          String
  user            User            @relation(fields: [userId], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type])
  @@index([category])
  @@index([date])
  @@index([userId])
  @@index([transactionRef])
  @@map("finances")
}

// ─── PARTNER MODULE ────────────────────────────────────────────────

model Partner {
  id                  String   @id @default(cuid())
  name                String
  email               String?
  phone               String?
  investmentAmount    Float    @default(0)
  profitSharePercent  Float    @default(0) // e.g., 25 means 25%
  totalWithdrawals    Float    @default(0)
  currentBalance      Float    @default(0)
  // Calculated: currentBalance = (total_profit * profitSharePercent/100) - totalWithdrawals + investmentAmount
  notes               String?
  isActive            Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("partners")
}

// ─── INVOICES ──────────────────────────────────────────────────────

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  type          String   // "SALE", "PROJECT", "PURCHASE"
  referenceId   String   // Sale ID or Project ID
  customerName  String
  customerEmail String?
  customerPhone String?
  items         String   // JSON string of items
  subtotal      Float
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float
  status        String   @default("ISSUED") // DRAFT, ISSUED, PAID, CANCELLED
  dueDate       DateTime?
  notes         String?
  generatedBy   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("invoices")
}

// ─── ATTACHMENTS ───────────────────────────────────────────────────

model Attachment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename   String
  url        String
  size       Int?
  type       String?

  createdAt  DateTime @default(now())

  @@map("attachments")
}

// ─── NOTIFICATIONS ─────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  metadata  String?          // JSON for extra data

  createdAt DateTime         @default(now())

  @@map("notifications")
}

// ─── SETTINGS ──────────────────────────────────────────────────────

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON value

  @@map("settings")
}

// ─── SUPPLIER PAYMENTS ─────────────────────────────────────────────

model SupplierPayment {
  id            String           @id @default(cuid())
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  amount        Float
  paymentMethod PaymentMethodType @default(CASH)
  chequeNumber  String?
  bankName      String?
  date          DateTime         @default(now())
  notes         String?
  purchaseId    String?          // Optional link to specific purchase
  userId        String           // Who recorded the payment

  createdAt     DateTime         @default(now())

  @@map("supplier_payments")
}

// ─── CUSTOMER PAYMENTS ─────────────────────────────────────────────

model CustomerPayment {
  id            String           @id @default(cuid())
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  amount        Float
  paymentMethod PaymentMethodType @default(CASH)
  chequeNumber  String?
  bankName      String?
  date          DateTime         @default(now())
  notes         String?
  saleId        String?          // Optional link to specific sale
  userId        String           // Who recorded the payment

  createdAt     DateTime         @default(now())

  @@map("customer_payments")
}

// ─── CASH SALE (Counter Sale) ──────────────────────────────────────

model CashSale {
  id            String           @id @default(cuid())
  receiptNo     String           @unique // CS-0001
  customerName  String?
  date          DateTime         @default(now())
  amount        Float
  remarks       String?
  paymentMethod PaymentMethodType @default(CASH)
  userId        String           // Who processed the sale

  createdAt     DateTime         @default(now())

  @@map("cash_sales")
}

// ─── FINANCIAL ACCOUNTS ────────────────────────────────────────────

model FinancialAccount {
  id             String            @id @default(cuid())
  name           String            @unique // "HBL Main", "Shop Cash", "Easypaisa"
  type           AccountType
  accountNumber  String?
  bankName       String?
  currentBalance Float             @default(0)
  isActive       Boolean           @default(true)
  notes          String?

  transfersFrom  AccountTransfer[] @relation("TransferFrom")
  transfersTo    AccountTransfer[] @relation("TransferTo")

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("financial_accounts")
}

// ─── ACCOUNT TRANSFERS ─────────────────────────────────────────────

model AccountTransfer {
  id              String           @id @default(cuid())
  fromAccountId   String
  fromAccount     FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId     String
  toAccount       FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  amount          Float
  transferType    TransferType
  voucherNumber   String?
  notes           String?
  date            DateTime         @default(now())
  userId          String           // Who performed the transfer

  createdAt       DateTime         @default(now())

  @@map("account_transfers")
}

// ─── EXPENDITURE (Daily Expenses) ──────────────────────────────────

model Expenditure {
  id          String   @id @default(cuid())
  category    String   // "RENT_SHOP", "RENT_GODOWN", "SALARY", "DAILY_MISC", "UTILITY", etc.
  amount      Float
  description String
  date        DateTime @default(now())
  accountId   String?  // Which account it was paid from
  userId      String   // Who recorded the expense

  createdAt   DateTime @default(now())

  @@map("expenditures")
}


// ═══ ACCOUNTING CORE (audit Reports 13/15; owner decisions OD-01..OD-11) ═══
// Additive tables. The older Sale/Purchase/CashSale/Finance tables are left unchanged.
// Quantities and exact document amounts are stored as exact decimal text (src/lib/domain/decimal.ts);
// journal amounts are whole paisa so balances can be summed exactly in SQL.

// Chart of accounts: system GL accounts, parties (customers, suppliers, press, Counter Sale) and cash/bank
model LedgerAccount {
  id                 String   @id @default(cuid())
  code               String   @unique // "SALES_REVENUE", "COUNTER_SALE", "P-0001"
  name               String
  kind               String   // "GL" | "PARTY" | "CASH_BANK"
  subType            String?  // GL: ASSET/LIABILITY/EQUITY/INCOME/EXPENSE; PARTY: CUSTOMER/SUPPLIER/PRESS/OTHER; CASH_BANK: CASH/BANK
  customerId         String?  @unique
  supplierId         String?  @unique
  financialAccountId String?  @unique
  phone              String?
  address            String?
  isSystem           Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  journalLines       JournalLine[]
  partyDocuments     AccountingDocument[] @relation("DocumentParty")
  cashDocuments      AccountingDocument[] @relation("DocumentCashAccount")
  pressLocations     StockLocation[]

  @@index([kind])
  @@map("ledger_accounts")
}

// Per-item unit model (F-01): base unit, configured pack units with conversion factors, reference cost
model ItemUnitProfile {
  id                     String   @id @default(cuid())
  componentId            String   @unique
  component              Component @relation(fields: [componentId], references: [id])
  kind                   String   @default("PIECE") // PAPER | PIECE | WEIGHT | ROLL | SERVICE
  baseUnit               String   @default("piece")
  baseDecimals           Int      @default(0)
  purchaseUnit           String?
  saleUnit               String?
  confirmed              Boolean  @default(false) // false = shown as "unit unconfirmed" (Report 13 D-C)
  referencePurchasePrice String?  // per purchase unit (F-02); paper: rate per kg
  referenceExpenses      String?  // per purchase unit; paper: expense per kg
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  conversions            ItemUnitConversion[]

  @@map("item_unit_profiles")
}

model ItemUnitConversion {
  id        String          @id @default(cuid())
  profileId String
  profile   ItemUnitProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  code      String          // "packet", "carton", "roll"
  factor    String          // base units per one of this unit
  decimals  Int             @default(0)

  @@unique([profileId, code])
  @@map("item_unit_conversions")
}

// Where stock physically is: the main store, or material held at a printing press (WIP, decision 2c)
model StockLocation {
  id             String         @id @default(cuid())
  code           String         @unique // "MAIN", "PRESS-<party code>"
  name           String
  kind           String         // "STORE" | "PRESS"
  partyAccountId String?
  partyAccount   LedgerAccount? @relation(fields: [partyAccountId], references: [id])
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  movements      StockMovement[]

  @@map("stock_locations")
}

// Every financial or stock document: invoices, cash sales, stock issues, press movements, vouchers
model AccountingDocument {
  id               String         @id @default(cuid())
  type             String         // PURCHASE_INVOICE | SALE_INVOICE | CASH_SALE | STOCK_ISSUE | PRESS_DISPATCH | PRESS_RECEIPT | PRESS_RETURN | PRESS_LOSS | VOUCHER | TRANSFER | OPENING_BALANCE
  series           String         // numbering series, e.g. "PI", "SI", "CS", "SIS", "CRV", "BRV", "CPV", "BPV", "JV"
  number           Int
  revision         Int            @default(0) // amendments keep the number and add a revision (OD-11)
  docNo            String         // series + number (+ revision), e.g. "CRV-0007", "SI-0012/R1"
  date             DateTime
  status           String         // DRAFT | PENDING_APPROVAL | POSTED | REJECTED | CANCELLED
  partyAccountId   String?
  partyAccount     LedgerAccount? @relation("DocumentParty", fields: [partyAccountId], references: [id])
  cashAccountId    String?
  cashAccount      LedgerAccount? @relation("DocumentCashAccount", fields: [cashAccountId], references: [id])
  counterAccountId String?        // voucher/stock issue: the other account (expense, party, GL)
  locationId       String?        // stock from/at
  toLocationId     String?        // stock to (press dispatch/return)
  reason           String?        // stock issue / loss reason code
  remarks          String?
  vendorBillNo     String?
  vendorBillDate   DateTime?      // null when blank (F-07)
  dueDate          DateTime?      // purchase bill: optional payment due date (Report 30)
  biltyNo          String?
  biltyDate        DateTime?
  roundingMode     String?        // RUPEE_HALF_EVEN | PAISA_HALF_EVEN
  exactTotal       String         @default("0")
  total            String         @default("0") // printed/posted total
  roundingAdjustment String       @default("0")
  amountReceived   String?        // cash sale
  extraCharge      String?        // press receipt: printing charge billed by the press
  previousBalance  String?        // party balance before this document (OD-09), set when posted
  newBalance       String?
  hasCostEstimate  Boolean        @default(false) // a line cost is ESTIMATED or UNAVAILABLE (OD-03)
  hasNegativeStock Boolean        @default(false) // a line left stock below zero (OD-04)
  createdById      String
  submittedAt      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  rejectionReason  String?
  postedAt         DateTime?
  cancelledById    String?
  cancelledAt      DateTime?
  cancelReason     String?
  supersedesId     String?        @unique // amended documents point at the version they replace (OD-11)
  supersedes       AccountingDocument?  @relation("Amendment", fields: [supersedesId], references: [id])
  supersededBy     AccountingDocument?  @relation("Amendment")
  printCount       Int            @default(0) // reprint marker (Report 14 §2)
  lastPrintedAt    DateTime?
  chargeId         String?        // CHARGE_EXPENSE: the charge record this posting belongs to
  returnOfId       String?        // SALE_RETURN / PURCHASE_RETURN: the original document
  returnOf         AccountingDocument?  @relation("Returns", fields: [returnOfId], references: [id])
  returns          AccountingDocument[] @relation("Returns")
  charge           ChargeRecord?  @relation("ChargePostings", fields: [chargeId], references: [id])
  commandId        String?        @unique // sync command that created this document (idempotency, Report 21)
  originDeviceId   String?        // device or hub the command came from; null when entered online
  source           String         @default("APP") // APP | LEGACY_IMPORT
  legacyRef        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lines            AccountingDocumentLine[]
  attachments      DocumentAttachment[]
  journalEntries   JournalEntry[]
  stockMovements   StockMovement[]
  relatedCharges   ChargeRecord[] @relation("ChargeSource")
  allocationsGiven    PaymentAllocation[] @relation("AllocationCredit") // receipts: where their money went
  allocationsReceived PaymentAllocation[] @relation("AllocationDebit")  // invoices and refunds: the money applied to them

  @@unique([series, number, revision])
  @@index([chargeId])
  @@index([returnOfId])
  @@index([type, date])
  @@index([partyAccountId, date])
  @@index([status])
  @@map("accounting_documents")
}

model AccountingDocumentLine {
  id           String             @id @default(cuid())
  documentId   String
  document     AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNo       Int
  componentId  String?
  component    Component?         @relation(fields: [componentId], references: [id])
  description  String?
  quantity     String             @default("0") // in `unit`
  unit         String?
  loose        String             @default("0") // loose base units (legacy "Qty")
  baseQuantity String             @default("0")
  unitPrice    String             @default("0") // per `unit`
  loosePrice   String             @default("0") // per base unit
  amount       String             @default("0") // exact line amount
  costAmount   String?            // cost of the quantity issued, null when unavailable
  costStatus   String?            // ACTUAL | ESTIMATED | UNAVAILABLE
  costNote     String?
  stockWarning String?            // negative stock warning (OD-04)
  consumedComponentId String?     // press receipt: material consumed to produce this line
  consumedQuantity    String?     // base units of that material
  returnOfLineNo      Int?        // return: line number on the original document
  bookQuantity        String?     // stock count: book quantity when the count was approved

  @@unique([documentId, lineNo])
  @@index([componentId])
  @@map("accounting_document_lines")
}

// Report 28: which receipt paid which invoice (or refund), and how much. The money itself moves only in the
// receipt's journal; an allocation only says what it was for, so applying or releasing one never posts anything.
// Rows are never deleted: a released allocation keeps who released it, when and why (amendment, cancellation).
model PaymentAllocation {
  id            String             @id @default(cuid())
  creditDocId   String             // the receipt (CRV/BRV) the money came from
  creditDoc     AccountingDocument @relation("AllocationCredit", fields: [creditDocId], references: [id])
  debitDocId    String             // the sale invoice / cash sale it pays, or the refund voucher (CPV/BPV) that paid it back
  debitDoc      AccountingDocument @relation("AllocationDebit", fields: [debitDocId], references: [id])
  amount        String             // exact decimal
  source        String             // RECEIPT | APPLY_CREDIT | AMENDMENT | REFUND
  movedFromId   String?            // AMENDMENT: the allocation on the previous revision this one replaces
  requestId     String?            @unique // one-time id of the screen action that made it (no duplicates on double submit)
  createdById   String
  createdAt     DateTime           @default(now())
  releasedAt    DateTime?
  releasedById  String?
  releaseReason String?

  @@index([creditDocId])
  @@index([debitDocId])
  @@map("payment_allocations")
}

model JournalEntry {
  id           String             @id @default(cuid())
  documentId   String
  document     AccountingDocument @relation(fields: [documentId], references: [id])
  date         DateTime
  kind         String             @default("POSTING") // POSTING | REVERSAL
  createdById  String
  createdAt    DateTime           @default(now())

  lines        JournalLine[]

  @@index([documentId])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  debitPaisa  BigInt        @default(0)
  creditPaisa BigInt        @default(0)
  memo        String?

  @@index([accountId])
  @@index([entryId])
  @@map("journal_lines")
}

model StockMovement {
  id           String             @id @default(cuid())
  documentId   String
  document     AccountingDocument @relation(fields: [documentId], references: [id])
  lineNo       Int?
  componentId  String
  component    Component          @relation(fields: [componentId], references: [id])
  locationId   String
  location     StockLocation      @relation(fields: [locationId], references: [id])
  date         DateTime
  kind         String             // RECEIPT (costed in) | ISSUE (costed out) | RELOCATE (between locations, cost unchanged)
  quantity     String             // signed base units (+ in, - out)
  balanceAfter String             // item balance at this location after the movement
  costAmount   String?            // signed value moved, null when unavailable
  costStatus   String?
  warning      String?
  createdAt    DateTime           @default(now())

  @@index([componentId, locationId])
  @@index([documentId])
  @@map("stock_movements")
}

// Running weighted-average cost and stock per item and location (rebuildable from StockMovement)
model ItemStockBalance {
  id          String   @id @default(cuid())
  componentId String
  component   Component @relation(fields: [componentId], references: [id])
  locationId  String
  onHand      String   @default("0")
  updatedAt   DateTime @updatedAt

  @@unique([componentId, locationId])
  @@map("item_stock_balances")
}

model ItemCostState {
  id          String   @id @default(cuid())
  componentId String   @unique
  component   Component @relation(fields: [componentId], references: [id])
  onHand      String   @default("0") // all locations
  averageCost String?  // per base unit; null = never costed
  updatedAt   DateTime @updatedAt

  @@map("item_cost_states")
}

model DocumentSeries {
  series     String @id
  nextNumber Int    @default(1)

  @@map("document_series")
}

// Who did what and when, with before/after snapshots (OD-11)
model AuditLog {
  id         String   @id @default(cuid())
  entity     String   // "AccountingDocument", "ItemUnitProfile", "AccountingSetting"
  entityId   String
  action     String   // CREATE | SUBMIT | APPROVE | REJECT | POST | CANCEL | AMEND | UPDATE
  userId     String
  reason     String?
  before     String?  // JSON
  after      String?  // JSON
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

model AccountingSetting {
  key         String   @id // NEGATIVE_STOCK_POLICY, STOCK_ISSUE_APPROVAL, COUNTER_SALE_ACCOUNT, ...
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("accounting_settings")
}

// Freight, loading, bilty and printing charges (owner rules of 2026-10-22). Recording a charge never
// posts anything; only an explicit "Post as expense" creates a CHARGE_EXPENSE document and journal.
model ChargeRecord {
  id               String              @id @default(cuid())
  number           Int                 @unique
  chargeNo         String              @unique // "CHG-0001"
  kind             String              // FREIGHT | LOADING | BILTY | OTHER_PURCHASE | PRINTING
  date             DateTime
  amount           String              // exact, at most 2 decimals
  description      String
  partyAccountId   String?             // supplier, press or transporter the charge relates to
  documentId       String?             // purchase or press-work document it relates to
  document         AccountingDocument? @relation("ChargeSource", fields: [documentId], references: [id])
  reference        String?             // free-text reference (bilty no, press job, bill no)
  status           String              // RECORDED | POSTED | CANCELLED
  postedDocumentId String?             @unique // the one active expense posting; null unless POSTED
  commandId        String?             @unique // sync command that recorded this charge
  createdById      String
  cancelledById    String?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  postings         AccountingDocument[] @relation("ChargePostings")

  @@index([documentId])
  @@index([status])
  @@map("charge_records")
}

// ═══ OFFLINE SYNC FOUNDATION (Reports 20/21) ═══
// Devices and hubs never post to the ledger: they queue commands that the cloud (the only ledger
// authority) executes exactly once. Results return to every replica through the change log.

model Device {
  id            String    @id @default(cuid())
  code          String    @unique // short code used in provisional references, e.g. "D03"
  name          String
  role          String    // DEVICE | HUB
  secretHash    String    // sha256 of the device secret; the secret itself is only on the device (DPAPI)
  status        String    @default("ACTIVE") // ACTIVE | REVOKED
  hubId         String?   // devices in an office sync through this hub (Mode A)
  registeredById String
  registeredAt  DateTime  @default(now())
  revokedAt     DateTime?
  lastSeenAt    DateTime?
  appVersion    String?

  @@map("devices")
}

// Authority side: one row per (device, command) ever received, so retries return the stored result
model SyncInbox {
  id          String   @id @default(cuid())
  deviceId    String
  commandId   String
  requestHash String   // sha256 of the canonical command; a different body under the same id is refused
  status      String   // ACCEPTED | REJECTED | CONFLICT
  result      String   // JSON result returned to the device
  documentId  String?
  createdAt   DateTime @default(now())

  @@unique([deviceId, commandId])
  @@map("sync_inbox")
}

// Device / hub side: durable queue of commands waiting for the authority
model OutboxCommand {
  id             String    @id // command id (UUID), stable across retries
  seq            Int       @unique // submission order on this node
  type           String    // CREATE_DOCUMENT | DOCUMENT_ACTION | RECORD_CHARGE | CHARGE_ACTION
  payload        String    // JSON command body
  preview        String?   // JSON preview computed locally with the same posting service
  provisionalRef String?   // "P-D03-0007" shown and printed until the official number arrives
  officialNumber String?   // number assigned by a hub from a reserved block (Mode A)
  dependsOn      String?   // command id that must be accepted first (e.g. approve after create)
  originDeviceId String?   // hub relay: the device that submitted the command
  status         String    // PENDING_SYNC | SYNCING | SYNCED | NEEDS_REVIEW | FAILED_RETRY | CANCELLED
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  result         String?   // JSON from the authority: status, documentId, docNo, message
  createdById    String
  createdAt      DateTime  @default(now())
  syncedAt       DateTime?

  @@index([status, seq])
  @@map("outbox_commands")
}

// Row changes recorded by triggers; the change feed that replicas pull (Report 21 §4)
model ChangeLog {
  seq   Int      @id @default(autoincrement())
  tbl   String
  rowId String
  op    String   // I | U | D
  at    String   @default("") // UTC text written by the triggers

  @@map("change_log")
}

model SyncCursor {
  upstreamId String   @id // which upstream (cloud or hub) the cursor belongs to
  lastSeq    Int      @default(0)
  epoch      String? // the upstream's SYNC_EPOCH when last synchronised; a change means it was restored
  updatedAt  DateTime @updatedAt

  @@map("sync_cursors")
}

/// Values belonging to this computer only; never replicated (Report 23 §5).
model NodeState {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("node_state")
}

// Official number ranges reserved by the cloud for a hub, so a hub can number documents during an outage
model NumberBlock {
  id         String   @id @default(cuid())
  series     String
  fromNumber Int
  toNumber   Int
  nextNumber Int
  deviceId   String   // the hub holding the block
  status     String   @default("ACTIVE") // ACTIVE | EXHAUSTED | RELEASED
  createdAt  DateTime @default(now())

  @@unique([series, fromNumber])
  @@map("number_blocks")
}

// ═══ LOCAL BACKUPS (Report 22) — per node, never replicated ═══
model BackupSettings {
  id                  String   @id @default("local")
  enabled             Boolean  @default(false)
  directory           String?  // folder chosen by the owner (Windows folder picker on desktops)
  dailyTime           String   @default("02:00") // local time HH:MM
  frequentMinutes     Int      @default(60)      // extra snapshots while there are changes; 0 = off
  keepDaily           Int      @default(14)
  keepFrequent        Int      @default(24)
  protectedPassphrase String?  // DPAPI-protected on Windows; never stored in plain text
  updatedById         String?
  updatedAt           DateTime @updatedAt

  @@map("backup_settings")
}

model BackupRun {
  id           String    @id // backup id (UUID), also in the file name and manifest
  type         String    // DAILY | FREQUENT | MANUAL | PRE_RESTORE
  status       String    // RUNNING | VERIFIED | FAILED | DELETED
  trigger      String    // SCHEDULE | MISSED_AT_STARTUP | USER | SYSTEM
  file         String?
  sizeBytes    Int?
  changeSeq    Int?      // change-log position covered by the backup
  manifest     String?   // JSON
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  uploadStatus String?   // Google Drive (Phase 7): QUEUED | UPLOADING | UPLOADED | FAILED
  uploadRef    String?   // remote file id once uploaded and verified
  uploadError  String?
  uploadedAt   DateTime?
  uploadSession  String?  // resumable upload session URL (resumes after a restart)
  uploadAttempts Int      @default(0)
  uploadNextAt   DateTime?

  @@index([status, startedAt])
  @@map("backup_runs")
}

// Google Drive destination for this node's backups (Report 22 §8). Never replicated.
model DriveConnection {
  id                    String    @id @default("local")
  status                String    // PENDING | CONNECTED | REVOKED | ERROR
  accountEmail          String?
  folderId              String?
  folderName            String?
  protectedRefreshToken String?   // DPAPI on desktops; AES-GCM with CRM_TOKEN_KEY on servers
  pkceVerifier          String?   // only while an authorisation is in progress
  oauthState            String?
  redirectUri           String?
  uploadFrequent        Boolean   @default(false) // also upload the extra (frequent) backups
  keepRemote            Int       @default(30)
  lastError             String?
  quotaBytes            String?
  usedBytes             String?
  connectedById         String?
  connectedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  @@map("drive_connections")
}

// Supplier documents (scanned bill, delivery note) kept with a Books document (Report 30). Never deleted.
model DocumentAttachment {
  id           String             @id @default(cuid())
  documentId   String
  document     AccountingDocument @relation(fields: [documentId], references: [id])
  fileName     String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes
  note         String?
  uploadedById String
  createdAt    DateTime           @default(now())
  removedAt    DateTime?
  removedById  String?
  removeReason String?

  @@index([documentId])
  @@map("document_attachments")
}
